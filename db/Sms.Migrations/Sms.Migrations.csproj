<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Runnable as a CLI for prod migrations, while still referenced as a library by Sms.Api and the
         tests. StartupObject avoids emitting a top-level Program type that would clash with Sms.Api's
         Program in the test project. See MigrateCli.cs for the entrypoint usage. -->
    <OutputType>Exe</OutputType>
    <StartupObject>Sms.Migrations.MigrateCli</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentMigrator" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner.SqlServer" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="procs/**/*.sql" />
  </ItemGroup>

</Project>
